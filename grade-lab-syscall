#!/usr/bin/env python

import re
from gradelib import *  # 导入测试框架库

# 创建测试运行器，指定输出保存到 "xv6.out" 文件
r = Runner(save("xv6.out"))

# 测试：跟踪特定系统调用 (read, 编号32) 在 grep 命令中的使用 (分值5)
@test(5, "trace 32 grep")
def test_trace_32_grep():
    # 在 QEMU 模拟器中运行命令：trace 32 grep hello README
    r.run_qemu(shell_script([
        'trace 32 grep hello README'
    ]))
    # 验证输出中包含三次 read 系统调用的跟踪记录
    r.match('^\\d+: syscall read -> 1023')  # 匹配第一次读取 (1023字节)
    r.match('^\\d+: syscall read -> 966')   # 匹配第二次读取 (966字节)
    r.match('^\\d+: syscall read -> 0')     # 匹配最后一次读取 (0字节，文件结束)

# 测试：跟踪所有系统调用 (使用最大掩码值) 在 grep 命令中的使用 (分值5)
@test(5, "trace all grep")
def test_trace_all_grep():
    # 2147483647 是最大整数，二进制全1，表示跟踪所有系统调用
    r.run_qemu(shell_script([
        'trace 2147483647 grep hello README'
    ]))
    # 验证输出中包含多个系统调用的跟踪记录
    r.match('^\\d+: syscall trace -> 0')   # trace 系统调用
    r.match('^\\d+: syscall exec -> 3')    # exec 系统调用
    r.match('^\\d+: syscall open -> 3')    # open 系统调用
    r.match('^\\d+: syscall read -> 1023') # read 系统调用
    r.match('^\\d+: syscall read -> 966')  
    r.match('^\\d+: syscall read -> 0')
    r.match('^\\d+: syscall close -> 0')   # close 系统调用

# 测试：不进行跟踪时，确保没有系统调用信息输出 (分值5)
@test(5, "trace nothing")
def test_trace_nothing():
    r.run_qemu(shell_script([
        'grep hello README'  # 直接运行 grep，不使用 trace
    ]))
    # 验证输出中没有任何系统调用跟踪信息
    r.match(no=[".* syscall .*"])  # no 参数表示不应匹配的模式

# 测试：跟踪子进程的系统调用 (分值5)
@test(5, "trace children")
def test_trace_children():
    r.run_qemu(shell_script([
        'trace 2 usertests forkforkfork'  # 跟踪 fork 系统调用 (编号2)
    ]))
    # 验证 fork 系统调用的跟踪记录
    r.match('3: syscall fork -> 4')        # 第一次 fork
    r.match('^5: syscall fork -> \\d+')    # 后续 fork (PID 5)
    r.match('^6: syscall fork -> \\d+')    # 后续 fork (PID 6)
    r.match('^\\d+: syscall fork -> -1')   # fork 失败 (返回 -1)
    r.match('^ALL TESTS PASSED')           # 验证测试程序最终输出

# 测试：系统信息测试程序 (分值14)
@test(14, "sysinfotest")
def test_sysinfotest():
    r.run_qemu(shell_script([
        'sysinfotest'  # 运行系统信息测试程序
    ]))
    # 验证测试通过
    r.match('^sysinfotest: OK', no=[".* FAIL .*"])  # 必须包含 OK，不能包含 FAIL

# 测试：运行时间检查 (分值1)
@test(1, "time")
def test_time():
    check_time()  # 检查测试运行时间 (具体实现在 gradelib 中)

# 运行所有测试
run_tests()